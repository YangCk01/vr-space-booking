{
  "name": "vr-space-server",
  "version": "1.0.0",
  "description": "VR大空间预约排场系统后端 API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "dev:dev": "nodemon src/server.ts --dev",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "ts-node src/utils/seed.ts",
    "db:studio": "prisma studio",
    "lint": "tsc --noEmit",
    "test:recon": "node scripts/recon-smoke-test.js",
    "test:finance-summary": "node scripts/finance-summary-check.js"
  },
  "keywords": [
    "vr",
    "booking",
    "venue"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^4.2.1",
    "dotenv": "^16.5.1",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.2.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.32",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.10",
    "prisma": "6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}

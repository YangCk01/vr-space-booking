generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                 @id @default(uuid())
  phone             String                 @unique
  password          String
  name              String
  email             String?
  avatar            String?
  level             UserLevel              @default(NORMAL)
  totalVisits       Int                    @default(0)
  totalSpent        Int                    @default(0)
  status            UserStatus             @default(ACTIVE)
  registerDate      DateTime               @default(now())
  birthday          DateTime?
  lastLogin         DateTime?
  role              UserRole               @default(CUSTOMER)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  balance           Int                    @default(0)
  points            Int                    @default(0)
  bonusBalance      Int                    @default(0)
  principalBalance  Int                    @default(0)
  transactions      BalanceTransaction[]
  bookings          Booking[]
  executionLogs     CampaignExecutionLog[]
  campaignTracks    CampaignTrack[]
  notifications     Notification[]
  logs              OperationLog[]
  orders            Order[]
  pointsExchanges   PointsExchange[]
  pointsOrders      PointsOrder[]
  recharges         RechargeRecord[]
  thirdPartyCoupons ThirdPartyCoupon[]
  userCoupons       UserCoupon[]
  managedVenues     VenueManager[]
  roles             Role[]                 @relation("RoleToUser")
}

model Venue {
  id                   String             @id @default(uuid())
  name                 String
  theme                String
  status               VenueStatus        @default(FREE)
  area                 Int
  capacity             Int
  image                String?
  description          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  maintenanceEndDate   DateTime?          @db.Date
  maintenanceEndTime   String?
  maintenanceStartDate DateTime?          @db.Date
  maintenanceStartTime String?
  pricePerHour         Int                @default(0)
  address              String?
  phone                String?
  deviceCount          Int                @default(1)
  closeTime            String?            @default("22:00")
  openTime             String?            @default("09:00")
  mapLinks             Json?
  qrCode               String?
  serviceQr            String?
  bookings             Booking[]
  deviceLogs           DeviceSessionLog[]
  equipment            Equipment[]
  managers             VenueManager[]
  groupBuyPackages     GroupBuyPackage[] @relation("GroupBuyPackageToVenue")
}

model VenueManager {
  id        String   @id @default(uuid())
  userId    String
  venueId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([userId])
  @@index([venueId])
}

model Booking {
  id                 String             @id @default(uuid())
  venueId            String
  userId             String?
  type               BookingType
  title              String
  date               DateTime           @db.Date
  startTime          String
  endTime            String
  personName         String
  personPhone        String
  personCount        Int                @default(1)
  note               String?
  status             BookingStatus      @default(CONFIRMED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  gameId             String?
  remindSent         Boolean            @default(false)
  checkedInAt        DateTime?
  playingStartedAt   DateTime?
  playingEndedAt     DateTime?
  noShowAt           DateTime?
  bookingMode        BookingMode        @default(SINGLE)
  game               Game?              @relation(fields: [gameId], references: [id])
  user               User?              @relation(fields: [userId], references: [id])
  venue              Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  assignedEquipments BookingEquipment[]
  order              Order?
}

model Order {
  id                  String               @id @default(uuid())
  orderNo             String               @unique
  bookingId           String?              @unique
  userId              String?
  venueId             String?
  venueName           String?
  amount              Int
  status              OrderStatus          @default(PENDING)
  payMethod           PayMethod?
  paidAt              DateTime?
  cancelledAt         DateTime?
  refundAmount        Int?
  bookingTime         String?
  expireAt            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  source              OrderSource          @default(OFFLINE)
  bonusDeduction      Int                  @default(0)
  discountAmount      Int                  @default(0)
  discountRate        Int                  @default(100)
  originalAmount      Int                  @default(0)
  pointsDeduction     Int                  @default(0)
  pointsUsed          Int                  @default(0)
  principalDeduction  Int                  @default(0)
  userCouponId        String?
  couponDiscount      Int                  @default(0)
  noShowAt            DateTime?
  noShowReason        String?
  penaltyAmount       Int?
  standbyConverted    Boolean              @default(false)
  verifiedAt          DateTime?
  playingStartedAt    DateTime?
  playingEndedAt      DateTime?
  rescheduleCount     Int                  @default(0)
  rescheduleFeeAmount Int                  @default(0)
  quantity            Int                  @default(1)
  verifyCode          String?              @unique
  groupBuyPackageId   String?
  orderKind           String               @default("NORMAL")
  feeType             String?
  parentOrderId       String?
  feeReason           String?
  disruptionStatus    String               @default("NONE")
  disruptionReason    String?
  disruptionSource    String?
  disruptionAt        DateTime?
  metadata            Json?
  transactions        BalanceTransaction[]
  booking             Booking?             @relation(fields: [bookingId], references: [id])
  userCoupon          UserCoupon?          @relation(fields: [userCouponId], references: [id])
  user                User?                @relation(fields: [userId], references: [id])
  groupBuyPackage     GroupBuyPackage?     @relation(fields: [groupBuyPackageId], references: [id])
  parentOrder         Order?               @relation("OrderFeeOrders", fields: [parentOrderId], references: [id])
  feeOrders           Order[]              @relation("OrderFeeOrders")
  payments            Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([orderKind])
  @@index([feeType])
  @@index([parentOrderId])
  @@index([disruptionStatus])
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  type            ApprovalType
  status          ApprovalStatus @default(PENDING)
  targetType      String
  targetId        String
  targetDesc      String?
  requesterId     String
  requesterName   String
  requesterRole   String
  approverId      String?
  approverName    String?
  approverRole    String?
  requestPayload  Json
  beforeValue     Json?
  afterValue      Json?
  amount          Int?
  reason          String
  approvalComment String?
  executedAt      DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([type])
  @@index([status])
  @@index([targetType, targetId])
  @@index([requesterId])
  @@index([approverId])
  @@index([createdAt])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  amount        Int
  method        PayMethod
  transactionId String?
  status        PaymentStatus @default(SUCCESS)
  createdAt     DateTime      @default(now())
  order         Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([createdAt])
}

model Equipment {
  id                 String              @id @default(uuid())
  name               String
  model              String
  code               String              @unique
  type               EquipmentType
  status             EquipmentStatus     @default(NORMAL)
  venueId            String?
  buyDate            DateTime?
  warranty           DateTime?
  lastMaint          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  bookingAssignments BookingEquipment[]
  venue              Venue?              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  maintenances       MaintenanceRecord[]
}

model BookingEquipment {
  id          String    @id @default(uuid())
  bookingId   String
  equipmentId String
  assignedAt  DateTime  @default(now())
  releasedAt  DateTime?
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([bookingId, equipmentId])
  @@index([bookingId])
  @@index([equipmentId])
  @@index([assignedAt])
}

model UserBenefitUsage {
  id          String   @id @default(uuid())
  userId      String
  benefitType String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  totalQuota  Int      @default(0)
  usedQuota   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, benefitType, periodStart])
  @@index([userId])
}

model MaintenanceRecord {
  id          String    @id @default(uuid())
  equipmentId String
  date        DateTime
  type        String
  description String
  operator    String?
  createdAt   DateTime  @default(now())
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String
  updatedAt DateTime @updatedAt
}

model OperationLog {
  id        String   @id @default(uuid())
  userId    String?
  operator  String
  type      String
  content   String
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model BackupRecord {
  id        String   @id @default(uuid())
  fileName  String
  filePath  String
  size      Int
  type      String
  status    String
  createdAt DateTime @default(now())
}

model RechargeRecord {
  id        String    @id @default(uuid())
  userId    String
  amount    Int
  bonus     Int
  total     Int
  payMethod String
  status    String    @default("PENDING")
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model BalanceTransaction {
  id              String   @id @default(uuid())
  userId          String
  type            String
  amount          Int
  orderId         String?
  rechargeId      String?
  remark          String?
  createdAt       DateTime @default(now())
  bonusAmount     Int      @default(0)
  pointsAmount    Int      @default(0)
  principalAmount Int      @default(0)
  totalAmount     Int      @default(0)
  order           Order?   @relation(fields: [orderId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([rechargeId])
  @@index([createdAt])
  @@index([type])
}

model Game {
  id              String            @id @default(uuid())
  title           String
  subtitle        String?
  description     String?
  coverImage      String?
  videoUrl        String?
  price           Int               @default(0)
  duration        Int               @default(30)
  minPlayers      Int               @default(1)
  maxPlayers      Int               @default(4)
  tags            String[]
  status          String            @default("ACTIVE")
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  detailImages    String[]
  notice          String?
  bookings        Booking[]
  groupBuyPackages GroupBuyPackage[]
}

model GroupBuyPackage {
  id                    String   @id @default(uuid())
  gameId                String
  title                 String
  subtitle              String?
  type                  String   @default("DOUBLE") // DOUBLE / THREE / PRIVATE
  label                 String   @default("双人团")
  minPeople             Int      @default(2)
  maxPeople             Int      @default(2)
  originalPricePerPerson Int     @default(0)
  groupPricePerPerson   Int      @default(0)
  totalGroupPrice       Int      @default(0)
  coverImage            String?
  tags                  String[]
  status                String   @default("ACTIVE") // ACTIVE / INACTIVE
  sortOrder             Int      @default(0)
  startDate             DateTime? @db.Date
  endDate               DateTime? @db.Date
  description           String?
  soldText              String   @default("近期售 200+")
  refundTags            String[] @default(["随时退", "过期自动退"])
  packageItems          String[] @default([])
  processSteps          String[] @default(["购买团购券", "选择门店与场次", "到店核销入场"])
  notice                String?
  refundNotice          String?
  buyButtonText         String   @default("立即抢购")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  game                  Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  venues                Venue[]  @relation("GroupBuyPackageToVenue")
  orders                Order[]

  @@index([gameId])
  @@index([status])
  @@index([type])
}

model DailyFinancialReport {
  id                      String    @id @default(uuid())
  date                    String    @unique
  rechargePrincipalIn     Int       @default(0)
  directPayIn             Int       @default(0)
  refundOut               Int       @default(0)
  netCashFlow             Int       @default(0)
  directRevenue           Int       @default(0)
  memberPrincipalRevenue  Int       @default(0)
  totalRecognizedRevenue  Int       @default(0)
  pointsDiscountCost      Int       @default(0)
  pointsExchangeCost      Int       @default(0)
  pointsGiftCost          Int       @default(0)
  couponDiscountCost      Int       @default(0)
  couponGiftCount         Int       @default(0)
  experienceGiftCount     Int       @default(0)
  couponCampaignCount     Int       @default(0)
  experienceCampaignCount Int       @default(0)
  couponUsedCount         Int       @default(0)
  experienceUsedCount     Int       @default(0)
  totalPrincipalLiability Int       @default(0)
  totalBonusLiability     Int       @default(0)
  pointsLiability         Int       @default(0)
  dormantPrincipal        Int       @default(0)
  prepaidDirectRevenue    Int       @default(0)
  confirmedDirectRevenue  Int       @default(0)
  prepaidMemberRevenue    Int       @default(0)
  confirmedMemberRevenue  Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  noShowPenalty           Int       @default(0)
  otherIncomeTotal        Int       @default(0)
  rescheduleFeeIncome     Int       @default(0)
  cancelFeeIncome         Int       @default(0)
  status                  String    @default("DRAFT")
  generatedAt             DateTime?
  generatedById           String?
  generatedByName         String?
  confirmedAt             DateTime?
  confirmedById           String?
  confirmedByName         String?
  lockedAt                DateTime?
  reopenedAt              DateTime?
  reopenedById            String?
  reopenedByName          String?
  reopenReason            String?

  @@index([status])
  @@index([generatedAt])
  @@index([confirmedAt])
}

model FinanceAdjustment {
  id           String   @id @default(uuid())
  adjustmentNo String   @unique
  source       String
  type         String
  status       String   @default("EXECUTED")
  targetType   String
  targetId     String
  targetDesc   String?
  amount       Int      @default(0)
  pointsAmount Int      @default(0)
  beforeValue  Json?
  afterValue   Json?
  reason       String
  operatorId   String
  operatorName String
  operatorRole String
  auditLogId   String?
  approvalId   String?
  executedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([source])
  @@index([type])
  @@index([status])
  @@index([targetType, targetId])
  @@index([operatorId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  content   String
  read      Boolean  @default(false)
  source    String   @default("SYSTEM")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PointsProduct {
  id           String              @id @default(uuid())
  name         String
  description  String?
  image        String?
  type         PointsProductType
  pointsCost   Int
  stock        Int                 @default(-1)
  status       PointsProductStatus @default(ON_SALE)
  discountRate Int?
  validityDays Int?
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  exchanges    PointsExchange[]
  pointsOrders PointsOrder[]

  @@index([status])
  @@index([type])
}

model PointsExchange {
  id          String         @id @default(uuid())
  userId      String
  productId   String
  pointsCost  Int
  status      ExchangeStatus @default(PENDING)
  fulfilledAt DateTime?
  remark      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  product     PointsProduct  @relation(fields: [productId], references: [id])
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

model UserCoupon {
  id           String           @id @default(uuid())
  userId       String
  name         String
  type         UserCouponType
  discountRate Int?
  status       UserCouponStatus @default(UNUSED)
  validFrom    DateTime?
  validTo      DateTime?
  usedAt       DateTime?
  usedOrderId  String?
  source       String?
  exchangeId   String?
  giftReason   String?
  giftRemark   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  orders       Order[]
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([validTo])
}

model ReconBatch {
  id                     String           @id @default(uuid())
  reconDate              String           @unique @db.VarChar(10)
  status                 String
  bizTotalCount          Int              @default(0)
  channelTotalCount      Int              @default(0)
  bankTotalCount         Int              @default(0)
  matchedCount           Int              @default(0)
  exceptionCount         Int              @default(0)
  matchedAmount          Int              @default(0)
  exceptionAmount        Int              @default(0)
  startedAt              DateTime?
  completedAt            DateTime?
  errorMessage           String?
  createdAt              DateTime         @default(now())
  orderPayExceptionCount Int              @default(0)
  orderPayMatchedCount   Int              @default(0)
  orderTxExceptionCount  Int              @default(0)
  orderTxMatchedCount    Int              @default(0)
  rechargeExceptionCount Int              @default(0)
  rechargeMatchedCount   Int              @default(0)
  refundExceptionCount   Int              @default(0)
  refundMatchedCount     Int              @default(0)
  exceptions             ReconException[]

  @@index([reconDate])
  @@index([status])
}

model ReconException {
  id                   String               @id @default(uuid())
  batchId              String
  exceptionType        ReconExceptionType
  exceptionStatus      ReconExceptionStatus @default(PENDING)
  bizType              String?
  bizOrderNo           String?
  bizAmount            Int?
  bizStatus            String?
  channel              String?
  channelTransactionId String?
  channelAmount        Int?
  channelFee           Int?
  channelStatus        String?
  bankSerialNo         String?
  bankAmount           Int?
  venueId              String?
  deviceId             String?
  hardwareSessions     Int?
  systemSessions       Int?
  diffAmount           Int
  handlerId            String?
  handlerName          String?
  handledAt            DateTime?
  handleRemark         String?
  handleAction         String?
  fixTransactionId     String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  batch                ReconBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([exceptionType])
  @@index([exceptionStatus])
  @@index([bizOrderNo])
  @@index([channelTransactionId])
  @@index([createdAt])
}

model ReconConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model ReconChannelBill {
  id                   String   @id @default(uuid())
  batchId              String
  channel              String
  channelTransactionId String   @unique
  merchantOrderNo      String
  transactionType      String
  transactionStatus    String
  buyerPaidAmount      Int
  refundAmount         Int      @default(0)
  channelFee           Int      @default(0)
  settlementAmount     Int
  feeRate              Float    @default(0.006)
  channelPaidAt        DateTime
  rawData              String?
  createdAt            DateTime @default(now())

  @@index([batchId])
  @@index([merchantOrderNo])
  @@index([channelPaidAt])
  @@index([channelTransactionId])
}

model ReconBankStatement {
  id               String   @id @default(uuid())
  batchId          String
  bankSerialNo     String   @unique
  bankName         String
  accountNo        String
  transactionDate  DateTime @db.Date
  counterpartyName String
  creditAmount     Int      @default(0)
  debitAmount      Int      @default(0)
  balance          Int
  abstract         String?
  rawData          String?
  createdAt        DateTime @default(now())

  @@index([batchId])
  @@index([transactionDate])
  @@index([counterpartyName])
}

model DeviceSessionLog {
  id                 String    @id @default(uuid())
  deviceId           String
  venueId            String
  appPackageName     String
  appName            String?
  sessionStartAt     DateTime
  sessionEndAt       DateTime?
  sessionDurationSec Int
  isCompleted        Boolean   @default(false)
  isTestSession      Boolean   @default(false)
  playerCount        Int       @default(1)
  rawLog             String?
  createdAt          DateTime  @default(now())
  venue              Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([appPackageName])
  @@index([sessionStartAt])
  @@index([isTestSession])
}

model ThirdPartyCoupon {
  id             String    @id @default(uuid())
  code           String    @unique
  source         String
  name           String
  description    String?
  discountAmount Int       @default(0)
  minOrderAmount Int       @default(0)
  status         String    @default("UNUSED")
  userId         String?
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User?     @relation(fields: [userId], references: [id])
}

model PointsOrder {
  id             String            @id @default(uuid())
  orderNo        String            @unique
  userId         String
  productId      String
  productName    String
  productType    PointsProductType
  pointsCost     Int
  quantity       Int               @default(1)
  deliveryType   String?
  recipientName  String?
  recipientPhone String?
  address        String?
  venueId        String?
  status         PointsOrderStatus @default(PENDING)
  trackingNumber String?
  shippedAt      DateTime?
  returnReason   String?
  returnedAt     DateTime?
  adminNote      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  product        PointsProduct     @relation(fields: [productId], references: [id])
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  operatorId   String
  operatorName String
  operatorRole String
  targetType   String
  targetId     String
  targetDesc   String?
  action       String
  actionName   String
  beforeValue  Json?
  afterValue   Json?
  diffValue    Json?
  amount       Int?
  reason       String
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([targetType, targetId])
  @@index([operatorId])
  @@index([action])
  @@index([createdAt])
}

model DataCheckResult {
  id           String   @id @default(uuid())
  checkType    String
  checkDate    String
  totalChecked Int
  errorCount   Int
  errors       Json?
  status       String
  createdAt    DateTime @default(now())

  @@index([checkType, checkDate])
}

model Campaign {
  id                         String                 @id @default(uuid())
  name                       String
  type                       String                 @default("MANUAL_GIFT")
  status                     String                 @default("DRAFT")
  startAt                    DateTime?
  endAt                      DateTime?
  budget                     Int?
  spent                      Int                    @default(0)
  deleted                    Boolean                @default(false)
  createdBy                  String
  autoPauseOnBudgetExhausted Boolean                @default(true)
  autoEndOnExpire            Boolean                @default(true)
  targetTags                 String[]               @default([])
  excludeTags                String[]               @default([])
  priority                   Int                    @default(0)
  exclusiveWith              String[]               @default([])
  maxPerUserTotal            Int?
  channel                    String?
  targetType                 String?
  targetValue                Int?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  executionLogs              CampaignExecutionLog[]
  rewards                    CampaignReward[]
  tracks                     CampaignTrack[]
}

model CampaignReward {
  id                 String   @id @default(uuid())
  campaignId         String
  rewardType         String
  pointsAmount       Int?
  couponName         String?
  couponDiscountRate Int?
  couponValidDays    Int?
  maxQuantity        Int      @default(0)
  issuedCount        Int      @default(0)
  usedCount          Int      @default(0)
  minOrderAmount     Int?
  applicableVenues   String[] @default([])
  applicableGames    String[] @default([])
  applicableWeekdays Int[]    @default([])
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model CampaignTrack {
  id         String   @id @default(uuid())
  campaignId String
  userId     String
  step       String
  orderId    String?
  amount     Int?
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId, userId])
  @@index([step])
}

model UserTag {
  id       String    @id @default(uuid())
  userId   String
  tag      String
  scoredAt DateTime  @default(now())
  expireAt DateTime?

  @@unique([userId, tag])
  @@index([userId])
  @@index([tag])
}

model CampaignExecutionLog {
  id               String    @id @default(uuid())
  campaignId       String
  userId           String
  triggerEvent     String
  triggerSource    String
  triggerPayload   Json?
  status           String
  reason           String?
  rewardType       String?
  rewardValue      Int?
  rewardCouponName String?
  costPoints       Int?
  costCoupon       Int?
  issuedAt         DateTime  @default(now())
  usedAt           DateTime?
  usedOrderId      String?
  usedAmount       Int?
  gmvGenerated     Int?
  createdAt        DateTime  @default(now())
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId, userId])
  @@index([campaignId, status])
  @@index([userId, createdAt])
  @@index([triggerEvent, createdAt])
}

model TriggerRule {
  id         String   @id @default(uuid())
  name       String
  event      String
  conditions Json?
  actions    Json
  enabled    Boolean  @default(true)
  runOnce    Boolean  @default(true)
  campaignId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CouponEffectReport {
  id                 String   @id @default(uuid())
  date               String
  couponType         String
  source             String
  giftedCount        Int      @default(0)
  usedCount          Int      @default(0)
  expiredCount       Int      @default(0)
  totalOrderAmount   Int      @default(0)
  avgOrderAmount     Int      @default(0)
  couponDiscountCost Int      @default(0)
  reorderUserCount   Int      @default(0)
  reorderAmount      Int      @default(0)
  createdAt          DateTime @default(now())

  @@unique([date, couponType, source])
  @@index([date])
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  module          String
  rolePermissions RolePermission[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]           @relation("RoleToUser")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model SystemConfig {
  key         String   @id
  value       String
  type        String   @default("STRING")
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model UserStoreBalance {
  id               String   @id @default(uuid())
  userId           String
  venueId          String
  principalBalance Int      @default(0)
  bonusBalance     Int      @default(0)
  totalRecharged   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, venueId])
  @@index([userId])
  @@index([venueId])
}


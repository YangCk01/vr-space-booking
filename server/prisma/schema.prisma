generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String               @id @default(uuid())
  phone             String               @unique
  password          String
  name              String
  email             String?
  avatar            String?
  level             UserLevel            @default(NORMAL)
  totalVisits       Int                  @default(0)
  totalSpent        Int                  @default(0)
  status            UserStatus           @default(ACTIVE)
  registerDate      DateTime             @default(now())
  lastLogin         DateTime?
  role              UserRole             @default(CUSTOMER)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  balance           Int                  @default(0)
  points            Int                  @default(0)
  bonusBalance      Int                  @default(0)
  principalBalance  Int                  @default(0)
  transactions      BalanceTransaction[]
  bookings          Booking[]
  notifications     Notification[]
  logs              OperationLog[]
  orders            Order[]
  pointsExchanges   PointsExchange[]
  pointsOrders      PointsOrder[]
  recharges         RechargeRecord[]
  thirdPartyCoupons ThirdPartyCoupon[]
  userCoupons       UserCoupon[]
  managedVenues     VenueManager[]
  roles             Role[]
}

model Venue {
  id                   String             @id @default(uuid())
  name                 String
  theme                String
  status               VenueStatus        @default(FREE)
  area                 Int
  capacity             Int
  image                String?
  description          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  maintenanceEndDate   DateTime?          @db.Date
  maintenanceEndTime   String?
  maintenanceStartDate DateTime?          @db.Date
  maintenanceStartTime String?
  pricePerHour         Int                @default(0)
  address              String?
  phone                String?
  deviceCount          Int                @default(1)
  closeTime            String?            @default("22:00")
  openTime             String?            @default("09:00")
  bookings             Booking[]
  deviceLogs           DeviceSessionLog[]
  equipment            Equipment[]
  managers             VenueManager[]
}

model VenueManager {
  id        String   @id @default(uuid())
  userId    String
  venueId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([userId])
  @@index([venueId])
}

model Booking {
  id          String        @id @default(uuid())
  venueId     String
  userId      String?
  type        BookingType
  title       String
  date        DateTime      @db.Date
  startTime   String
  endTime     String
  personName  String
  personPhone String
  personCount Int           @default(1)
  note        String?
  status      BookingStatus @default(CONFIRMED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  gameId      String?
  remindSent  Boolean       @default(false)
  game        Game?         @relation(fields: [gameId], references: [id])
  user        User?         @relation(fields: [userId], references: [id])
  venue       Venue         @relation(fields: [venueId], references: [id])
  order       Order?
}

model Order {
  id                 String               @id @default(uuid())
  orderNo            String               @unique
  bookingId          String?              @unique
  userId             String?
  venueId            String
  venueName          String
  amount             Int
  status             OrderStatus          @default(PENDING)
  payMethod          PayMethod?
  paidAt             DateTime?
  cancelledAt        DateTime?
  refundAmount       Int?
  bookingTime        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  source             OrderSource          @default(OFFLINE)
  bonusDeduction     Int                  @default(0)
  discountAmount     Int                  @default(0)
  discountRate       Int                  @default(100)
  originalAmount     Int                  @default(0)
  pointsDeduction    Int                  @default(0)
  pointsUsed         Int                  @default(0)
  principalDeduction Int                  @default(0)
  userCouponId       String?
  couponDiscount     Int                  @default(0)
  transactions       BalanceTransaction[]
  booking            Booking?             @relation(fields: [bookingId], references: [id])
  user               User?                @relation(fields: [userId], references: [id])
  userCoupon         UserCoupon?          @relation(fields: [userCouponId], references: [id])
  payments           Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  amount        Int
  method        PayMethod
  transactionId String?
  status        PaymentStatus @default(SUCCESS)
  createdAt     DateTime      @default(now())
  order         Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([createdAt])
}

model Equipment {
  id           String              @id @default(uuid())
  name         String
  model        String
  code         String              @unique
  type         EquipmentType
  status       EquipmentStatus     @default(NORMAL)
  venueId      String?
  buyDate      DateTime?
  warranty     DateTime?
  lastMaint    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  venue        Venue?              @relation(fields: [venueId], references: [id])
  maintenances MaintenanceRecord[]
}

model MaintenanceRecord {
  id          String    @id @default(uuid())
  equipmentId String
  date        DateTime
  type        String
  description String
  operator    String?
  createdAt   DateTime  @default(now())
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String
  updatedAt DateTime @updatedAt
}

model OperationLog {
  id        String   @id @default(uuid())
  userId    String?
  operator  String
  type      String
  content   String
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model BackupRecord {
  id        String   @id @default(uuid())
  fileName  String
  filePath  String
  size      Int
  type      String
  status    String
  createdAt DateTime @default(now())
}

model RechargeRecord {
  id        String    @id @default(uuid())
  userId    String
  amount    Int
  bonus     Int
  total     Int
  payMethod String
  status    String    @default("PENDING")
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model BalanceTransaction {
  id              String   @id @default(uuid())
  userId          String
  type            String
  amount          Int
  orderId         String?
  rechargeId      String?
  remark          String?
  createdAt       DateTime @default(now())
  bonusAmount     Int      @default(0)
  pointsAmount    Int      @default(0)
  principalAmount Int      @default(0)
  totalAmount     Int      @default(0)
  order           Order?   @relation(fields: [orderId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([rechargeId])
  @@index([createdAt])
  @@index([type])
}

model Game {
  id           String    @id @default(uuid())
  title        String
  subtitle     String?
  description  String?
  coverImage   String?
  price        Int       @default(0)
  duration     Int       @default(30)
  tags         String[]
  status       String    @default("ACTIVE")
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  detailImages String[]
  notice       String?
  bookings     Booking[]
}

model DailyFinancialReport {
  id                      String   @id @default(uuid())
  date                    String   @unique
  rechargePrincipalIn     Int      @default(0)
  directPayIn             Int      @default(0)
  refundOut               Int      @default(0)
  netCashFlow             Int      @default(0)
  directRevenue           Int      @default(0)
  memberPrincipalRevenue  Int      @default(0)
  totalRecognizedRevenue  Int      @default(0)
  pointsDiscountCost      Int      @default(0)
  pointsExchangeCost      Int      @default(0)
  pointsGiftCost          Int      @default(0)
  couponDiscountCost      Int      @default(0)
  couponGiftCount         Int      @default(0)
  experienceGiftCount     Int      @default(0)
  couponUsedCount         Int      @default(0)
  experienceUsedCount     Int      @default(0)
  totalPrincipalLiability Int      @default(0)
  totalBonusLiability     Int      @default(0)
  pointsLiability         Int      @default(0)
  dormantPrincipal        Int      @default(0)
  // P0: 收入确认拆分
  prepaidDirectRevenue    Int      @default(0)
  confirmedDirectRevenue  Int      @default(0)
  prepaidMemberRevenue    Int      @default(0)
  confirmedMemberRevenue  Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PointsProduct {
  id          String              @id @default(uuid())
  name        String
  description String?
  image       String?
  type        PointsProductType
  pointsCost  Int
  stock       Int                 @default(-1)
  status      PointsProductStatus @default(ON_SALE)
  discountRate Int?
  validityDays Int?
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  exchanges   PointsExchange[]
  pointsOrders PointsOrder[]

  @@index([status])
  @@index([type])
}

model PointsExchange {
  id          String         @id @default(uuid())
  userId      String
  productId   String
  pointsCost  Int
  status      ExchangeStatus @default(PENDING)
  fulfilledAt DateTime?
  remark      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  product     PointsProduct  @relation(fields: [productId], references: [id])
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

model UserCoupon {
  id           String           @id @default(uuid())
  userId       String
  name         String
  type         UserCouponType
  discountRate Int?
  status       UserCouponStatus @default(UNUSED)
  validFrom    DateTime?
  validTo      DateTime?
  usedAt       DateTime?
  usedOrderId  String?
  source       String?
  exchangeId   String?
  giftReason   String?
  giftRemark   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([userId])
  @@index([status])
  @@index([validTo])
}

model ReconBatch {
  id                     String           @id @default(uuid())
  reconDate              String           @unique @db.VarChar(10)
  status                 String
  bizTotalCount          Int              @default(0)
  channelTotalCount      Int              @default(0)
  bankTotalCount         Int              @default(0)
  matchedCount           Int              @default(0)
  exceptionCount         Int              @default(0)
  matchedAmount          Int              @default(0)
  exceptionAmount        Int              @default(0)
  startedAt              DateTime?
  completedAt            DateTime?
  errorMessage           String?
  createdAt              DateTime         @default(now())
  orderPayExceptionCount Int              @default(0)
  orderPayMatchedCount   Int              @default(0)
  orderTxExceptionCount  Int              @default(0)
  orderTxMatchedCount    Int              @default(0)
  rechargeExceptionCount Int              @default(0)
  rechargeMatchedCount   Int              @default(0)
  refundExceptionCount   Int              @default(0)
  refundMatchedCount     Int              @default(0)
  exceptions             ReconException[]

  @@index([reconDate])
  @@index([status])
}

model ReconException {
  id                   String               @id @default(uuid())
  batchId              String
  exceptionType        ReconExceptionType
  exceptionStatus      ReconExceptionStatus @default(PENDING)
  bizType              String?
  bizOrderNo           String?
  bizAmount            Int?
  bizStatus            String?
  channel              String?
  channelTransactionId String?
  channelAmount        Int?
  channelFee           Int?
  channelStatus        String?
  bankSerialNo         String?
  bankAmount           Int?
  venueId              String?
  deviceId             String?
  hardwareSessions     Int?
  systemSessions       Int?
  diffAmount           Int
  handlerId            String?
  handlerName          String?
  handledAt            DateTime?
  handleRemark         String?
  handleAction         String?
  fixTransactionId     String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  batch                ReconBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([exceptionType])
  @@index([exceptionStatus])
  @@index([bizOrderNo])
  @@index([channelTransactionId])
  @@index([createdAt])
}

model ReconConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model ReconChannelBill {
  id                   String   @id @default(uuid())
  batchId              String
  channel              String
  channelTransactionId String   @unique
  merchantOrderNo      String
  transactionType      String
  transactionStatus    String
  buyerPaidAmount      Int
  refundAmount         Int      @default(0)
  channelFee           Int      @default(0)
  settlementAmount     Int
  feeRate              Float    @default(0.006)
  channelPaidAt        DateTime
  rawData              String?
  createdAt            DateTime @default(now())

  @@index([batchId])
  @@index([merchantOrderNo])
  @@index([channelPaidAt])
  @@index([channelTransactionId])
}

model ReconBankStatement {
  id               String   @id @default(uuid())
  batchId          String
  bankSerialNo     String   @unique
  bankName         String
  accountNo        String
  transactionDate  DateTime @db.Date
  counterpartyName String
  creditAmount     Int      @default(0)
  debitAmount      Int      @default(0)
  balance          Int
  abstract         String?
  rawData          String?
  createdAt        DateTime @default(now())

  @@index([batchId])
  @@index([transactionDate])
  @@index([counterpartyName])
}

model DeviceSessionLog {
  id                 String    @id @default(uuid())
  deviceId           String
  venueId            String
  appPackageName     String
  appName            String?
  sessionStartAt     DateTime
  sessionEndAt       DateTime?
  sessionDurationSec Int
  isCompleted        Boolean   @default(false)
  isTestSession      Boolean   @default(false)
  playerCount        Int       @default(1)
  rawLog             String?
  createdAt          DateTime  @default(now())
  venue              Venue     @relation(fields: [venueId], references: [id])

  @@index([venueId])
  @@index([appPackageName])
  @@index([sessionStartAt])
  @@index([isTestSession])
}

model ThirdPartyCoupon {
  id             String    @id @default(uuid())
  code           String    @unique
  source         String
  name           String
  description    String?
  discountAmount Int       @default(0)
  minOrderAmount Int       @default(0)
  status         String    @default("UNUSED")
  userId         String?
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User?     @relation(fields: [userId], references: [id])
}

enum UserLevel {
  NORMAL
  MEMBER
  VIP
  VIP_PLUS
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  FINANCE
  CUSTOMER
  MANAGER
}

enum VenueStatus {
  FREE
  IN_USE
  MAINTENANCE
  DISABLED
}

enum BookingType {
  TEAM
  INDIVIDUAL
  CORPORATE
  MAINTENANCE
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
  REFUNDING
  REFUNDED
}

enum OrderSource {
  ONLINE
  OFFLINE
}

enum PayMethod {
  WECHAT
  ALIPAY
  CASH
  CARD
  BALANCE
  BALANCE_POINTS
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

enum TransactionType {
  RECHARGE
  DEDUCT
  REFUND
  POINTS_EARN
  POINTS_DEDUCT
  POINTS_GIFT
  CANCEL_RESTORE
  ADJUSTMENT
  FREEZE
}

enum EquipmentType {
  HEADSET
  TRACKER
  CONTROLLER
  COMPUTER
}

enum EquipmentStatus {
  NORMAL
  WARNING
  ERROR
  MAINTENANCE
}

enum PointsProductType {
  EXPERIENCE_TICKET
  PHYSICAL_GOOD
  COUPON
}

enum PointsProductStatus {
  ON_SALE
  OFF_SALE
  SOLD_OUT
}

enum ExchangeStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum UserCouponType {
  EXPERIENCE_FREE
  DISCOUNT
}

enum UserCouponStatus {
  UNUSED
  USED
  EXPIRED
}

enum ReconExceptionType {
  LONG
  SHORT
  AMOUNT_MISMATCH
  STATUS_MISMATCH
  FEE_MISMATCH
  DUPLICATE
  HARDWARE_MISMATCH
  UNKNOWN
}

enum PointsOrderStatus {
  PENDING
  SHIPPED
  COMPLETED
  RETURNED
  CANCELLED
}

model PointsOrder {
  id             String            @id @default(uuid())
  orderNo        String            @unique
  userId         String
  productId      String
  productName    String
  productType    PointsProductType
  pointsCost     Int
  quantity       Int               @default(1)

  deliveryType   String?           // PICKUP | DELIVERY
  recipientName  String?
  recipientPhone String?
  address        String?

  status         PointsOrderStatus @default(PENDING)
  trackingNumber String?
  shippedAt      DateTime?

  returnReason   String?
  returnedAt     DateTime?

  adminNote      String?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        PointsProduct     @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum ReconExceptionStatus {
  PENDING
  MANUAL_FIXED
  AUTO_FIXED
  FROZEN
  REFUNDED
  IGNORED
}

// ========== P0: 财务合规 ==========

model AuditLog {
  id            String   @id @default(uuid())
  operatorId    String
  operatorName  String
  operatorRole  String
  targetType    String
  targetId      String
  targetDesc    String?
  action        String
  actionName    String
  beforeValue   Json?
  afterValue    Json?
  diffValue     Json?
  amount        Int?
  reason        String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([targetType, targetId])
  @@index([operatorId])
  @@index([action])
  @@index([createdAt])
}

model DataCheckResult {
  id           String   @id @default(uuid())
  checkType    String
  checkDate    String
  totalChecked Int
  errorCount   Int
  errors       Json?
  status       String
  createdAt    DateTime @default(now())

  @@index([checkType, checkDate])
}

// ========== P1: 运营增长 ==========

model Campaign {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("MANUAL_GIFT") // AUTO_GIFT / MANUAL_GIFT / CONDITIONAL
  status      String   @default("DRAFT") // DRAFT / RUNNING / PAUSED / ENDED
  startAt     DateTime?
  endAt       DateTime?
  budget      Int?
  spent       Int      @default(0)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rewards     CampaignReward[]
  tracks      CampaignTrack[]
}

model CampaignReward {
  id                 String   @id @default(uuid())
  campaignId         String
  rewardType         String   // POINTS / COUPON_DISCOUNT / COUPON_EXPERIENCE
  pointsAmount       Int?
  couponName         String?
  couponDiscountRate Int?
  couponValidDays    Int?
  maxQuantity        Int      @default(0)
  issuedCount        Int      @default(0)
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model CampaignTrack {
  id         String   @id @default(uuid())
  campaignId String
  userId     String
  step       String   // ISSUED / USED / ORDER_COMPLETED / REORDERED
  orderId    String?
  amount     Int?
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, userId])
  @@index([step])
}

model UserTag {
  id       String   @id @default(uuid())
  userId   String
  tag      String
  scoredAt DateTime @default(now())
  expireAt DateTime?

  @@unique([userId, tag])
  @@index([userId])
  @@index([tag])
}

model TriggerRule {
  id        String   @id @default(uuid())
  name      String
  event     String
  conditions Json?
  actions   Json
  enabled   Boolean  @default(true)
  runOnce   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CouponEffectReport {
  id                 String @id @default(uuid())
  date               String
  couponType         String // DISCOUNT / EXPERIENCE_FREE
  source             String // MANUAL_GIFT / CAMPAIGN / EXCHANGE / RECHARGE_BONUS
  giftedCount        Int @default(0)
  usedCount          Int @default(0)
  expiredCount       Int @default(0)
  totalOrderAmount   Int @default(0)
  avgOrderAmount     Int @default(0)
  couponDiscountCost Int @default(0)
  reorderUserCount   Int @default(0)
  reorderAmount      Int @default(0)
  createdAt          DateTime @default(now())

  @@unique([date, couponType, source])
  @@index([date])
}

// ========== P2: 权限与配置 ==========

model Permission {
  id            String           @id @default(uuid())
  code          String           @unique
  name          String
  module        String
  rolePermissions RolePermission[]
}

model Role {
  id          String @id @default(uuid())
  name        String @unique
  description String?
  isSystem    Boolean @default(false)
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model SystemConfig {
  key         String @id
  value       String
  type        String @default("STRING") // STRING / NUMBER / JSON / BOOLEAN
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

// ========== P2: 资金池隔离（可选） ==========

model UserStoreBalance {
  id               String @id @default(uuid())
  userId           String
  venueId          String
  principalBalance Int @default(0)
  bonusBalance     Int @default(0)
  totalRecharged   Int @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, venueId])
  @@index([userId])
  @@index([venueId])
}
